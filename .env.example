# Шаблон переменных окружения. Скопируйте в .env и подставьте свои значения:
#   cp .env.example .env
# docker compose автоматически подхватывает .env.

# --- JWT / прочие секреты ---
# Ключ подписи JWT: base64 от строки >= 32 байт. Должен быть ОДИН для обоих сервисов.
# Сгенерировать: openssl rand -base64 32
INVEST_JWT_SECRET=
# Пароль для выдачи прав администратора через /getAdmin
INVEST_ADM_SECRET=
# Ключ к внешнему LLM API (генерация новостей)
INVEST_LLM_API_SECRET=

# --- PostgreSQL ---
POSTGRES_DB=postgres
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change-me
